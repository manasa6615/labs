8. Decision Tree using ID3
# Simple ID3 decision tree using information gain
import math
from collections import Counter
data = [
    (["Sunny", "Hot"], "No"),
    (["Sunny", "Cool"], "Yes"),
    (["Rainy", "Hot"], "Yes"),
    (["Rainy", "Cool"], "Yes")
]
attributes = ["Weather", "Temperature"]
def entropy(labels):
    counts = Counter(labels)
    total = len(labels)
    return -sum((n / total) * math.log2(n / total)
                for n in counts.values())
def id3(rows, attrs):
    labels = [label for _, label in rows]
    if len(set(labels)) == 1:
        return labels[0]
    if not attrs:
        return Counter(labels).most_common(1)[0][0]
    base = entropy(labels)
    best_attr = max(attrs, key=lambda a: base - sum(
        len(group) / len(rows) * entropy([label for _, label in group])
        for value in set(x[attributes.index(a)] for x, _ in rows)
        for group in [[r for r in rows
                       if r[0][attributes.index(a)] == value]]
    ))
    index = attributes.index(best_attr)
    tree = {best_attr: {}}
    for value in set(x[index] for x, _ in rows):
        subset = [r for r in rows if r[0][index] == value]
        tree[best_attr][value] = id3(
            subset, [a for a in attrs if a != best_attr]
        )
    return tree
print("Decision tree:", id3(data, attributes))
9. K-Means Clustering
# K-Means using scikit-learn
# Install once: pip install scikit-learn
from sklearn.cluster import KMeans
points = [[1, 2], [1, 4], [2, 3],
          [8, 8], [9, 10], [8, 9]]
model = KMeans(n_clusters=2, random_state=0, n_init=10)
model.fit(points)
print("Cluster labels:", model.labels_)
print("Cluster centers:", model.cluster_centers_)
