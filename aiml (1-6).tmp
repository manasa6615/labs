11. Backpropagation Algorithm
# Tiny neural network trained with backpropagation (XOR)
# Uses NumPy: pip install numpy
import numpy as np
np.random.seed(1)
X = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])
y = np.array([[0], [1], [1], [0]])
W1 = np.random.randn(2, 4)
b1 = np.zeros((1, 4))
W2 = np.random.randn(4, 1)
b2 = np.zeros((1, 1))
lr = 0.5
def sigmoid(x):
    return 1 / (1 + np.exp(-x))
for _ in range(10000):
    h = sigmoid(X @ W1 + b1)
    output = sigmoid(h @ W2 + b2)
    error = output - y
    d2 = error * output * (1 - output)
    dW2 = h.T @ d2
    db2 = np.sum(d2, axis=0, keepdims=True)
    d1 = (d2 @ W2.T) * h * (1 - h)
    dW1 = X.T @ d1
    db1 = np.sum(d1, axis=0, keepdims=True)
    W2 -= lr * dW2
    b2 -= lr * db2
    W1 -= lr * dW1
    b1 -= lr * db1
print("Predictions:")
print((output > 0.5).astype(int))
