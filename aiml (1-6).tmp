4. Knowledge Representation
# Simple knowledge representation using facts and rules
facts = {
    ("is_a", "dog", "animal"),
    ("has", "dog", "four_legs"),
    ("is_a", "parrot", "bird")
}
rules = {
    "dog": ["animal", "four_legs"],
    "parrot": ["bird", "animal"]
}
def ask(subject, property_name):
    return property_name in rules.get(subject, [])
print("Is dog an animal?", ask("dog", "animal"))
print("Does a dog have four legs?", ask("dog", "four_legs"))
print("Is a parrot a bird?", ask("parrot", "bird"))
5. Bayesian Network
# Small Bayesian network: Rain -> Wet Grass
# P(Rain) = 0.2
# P(Wet | Rain) = 0.9
# P(Wet | No Rain) = 0.1
p_rain = 0.2
p_wet_given_rain = 0.9
p_wet_given_no_rain = 0.1
p_wet = (p_wet_given_rain * p_rain +
         p_wet_given_no_rain * (1 - p_rain))
p_rain_given_wet = (
    p_wet_given_rain * p_rain / p_wet
)
print("P(Wet Grass) =", round(p_wet, 3))
print("P(Rain | Wet Grass) =", round(p_rain_given_wet, 3))
6. Hidden Markov Model (Viterbi Algorithm)
# Find the most likely hidden-state sequence
states = ["Rainy", "Sunny"]
start = {"Rainy": 0.6, "Sunny": 0.4}
transition = {
    "Rainy": {"Rainy": 0.7, "Sunny": 0.3},
    "Sunny": {"Rainy": 0.4, "Sunny": 0.6}
}
emission = {
    "Rainy": {"walk": 0.1, "shop": 0.4, "clean": 0.5},
    "Sunny": {"walk": 0.6, "shop": 0.3, "clean": 0.1}
}
observations = ["walk", "shop", "clean"]
prob = {}
path = {}
for state in states:
    prob[state] = start[state] * emission[state][observations[0]]
    path[state] = [state]
for obs in observations[1:]:
    new_prob, new_path = {}, {}
    for current in states:
        choices = [
            (prob[previous] * transition[previous][current]
             * emission[current][obs], previous)
            for previous in states
        ]
        best, previous = max(choices)
        new_prob[current] = best
        new_path[current] = path[previous] + [current]
    prob, path = new_prob, new_path
best_state = max(prob, key=prob.get)
print("Most likely states:", path[best_state])


