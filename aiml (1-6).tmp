2. A* Search Algorithm
# A* search: f(n) = g(n) + h(n)
graph = {
    'A': [('B', 1), ('C', 3)],
    'B': [('D', 1), ('E', 5)],
    'C': [('F', 2)],
    'D': [('G', 3)],
    'E': [('G', 1)],
    'F': [('G', 2)],
    'G': []
}
h = {'A': 4, 'B': 3, 'C': 2, 'D': 2, 'E': 1, 'F': 1, 'G': 0}
def astar(start, goal):
    open_list = [(h[start], 0, start, [start])]
    visited = set()
    while open_list:
        open_list.sort()
        f, cost, node, path = open_list.pop(0)
        if node == goal:
            return path, cost
        if node in visited:
            continue
        visited.add(node)
        for neighbour, weight in graph[node]:
            if neighbour not in visited:
                new_cost = cost + weight
                open_list.append(
                    (new_cost + h[neighbour], new_cost,
                     neighbour, path + [neighbour])
                )
    return None, None
path, cost = astar('A', 'G')
print("Path:", path)
print("Cost:", cost)
3A. Travelling Salesman Problem (TSP)
# Brute-force TSP for a small number of cities
from itertools import permutations
distance = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]
n = len(distance)
best_cost = float("inf")
best_route = None
for route in permutations(range(1, n)):
    route = (0,) + route + (0,)
    cost = sum(distance[route[i]][route[i + 1]]
               for i in range(n))
    if cost < best_cost:
        best_cost = cost
        best_route = route
print("Best route:", best_route)
print("Minimum cost:", best_cost)


